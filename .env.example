# Copy to .env in the repository root and fill in.
# .env is git-ignored: never commit it or put it in the Canvas zip.
# This file holds placeholders only, never real secrets.

# --- Database (Docker Compose) ---
POSTGRES_DB=bakeflow
POSTGRES_USER=bakeflow
# Choose your own. Avoid @ : / ? # % because it is embedded in a URL.
POSTGRES_PASSWORD=change-me

# --- Application ---
# development for local work. On the demo laptop use demo: it requires
# BAKEFLOW_APP_SECRET and still allows `python -m app.seed --reset --yes`.
BAKEFLOW_ENVIRONMENT=development
# Generate once with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Keep the same private value on every worker/restart; never commit it.
# Required outside development. Empty uses an ephemeral development-only key.
BAKEFLOW_APP_SECRET=
BAKEFLOW_TIMEZONE=Australia/Sydney
# The app is served at http://localhost:<port>, bound to 127.0.0.1 only.
BAKEFLOW_APP_PORT=8000
# Compose builds the database URL itself. Set this only when running the
# backend outside Docker against a database you can reach, e.g.
# BAKEFLOW_DATABASE_URL=postgresql+psycopg://bakeflow:change-me@localhost:5432/bakeflow

# --- Demo accounts created by `python -m app.seed` (BAKE-7) ---
# Logins: owner@bakeflow.test and customer@bakeflow.test. Choose your own
# passwords; keep them in private demo notes, not in the repository.
BAKEFLOW_SEED_OWNER_PASSWORD=change-me-owner
BAKEFLOW_SEED_CUSTOMER_PASSWORD=change-me-customer

# --- Integration tests (BAKE-7) ---
# Only for pytest against the throwaway test-db service; see README.
# BAKEFLOW_TEST_DATABASE_URL=postgresql+psycopg://bakeflow_test:bakeflow_test@127.0.0.1:55432/bakeflow_test

# --- LLM gateway (BAKE-9) ---
# mock: simulated responses, no network needed; the UI shows a "Mock mode"
# banner. live: calls the provider below. A missing provider setting fails the
# request instead of falling back to mock. If the provider is unreachable on
# demo day, switch back to mock (README, "Submission zip and demo day").
BAKEFLOW_LLM_MODE=mock
# Used only in live mode. Leave empty until a provider is chosen.
BAKEFLOW_LLM_BASE_URL=
BAKEFLOW_LLM_API_KEY=
BAKEFLOW_LLM_MODEL=
