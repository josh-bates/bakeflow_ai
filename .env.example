# Copy to .env in the repository root and fill in.
# .env is git-ignored: never commit it or put it in the Canvas zip.
# This file holds placeholders only, never real secrets.

# --- Database (Docker Compose) ---
POSTGRES_DB=bakeflow
POSTGRES_USER=bakeflow
# Choose your own. Avoid @ : / ? # % because it is embedded in a URL.
POSTGRES_PASSWORD=change-me

# --- Application ---
BAKEFLOW_ENVIRONMENT=development
BAKEFLOW_TIMEZONE=Australia/Sydney
# The app is served at http://localhost:<port>, bound to 127.0.0.1 only.
BAKEFLOW_APP_PORT=8000
# Compose builds the database URL itself. Set this only when running the
# backend outside Docker against a database you can reach, e.g.
# BAKEFLOW_DATABASE_URL=postgresql+psycopg://bakeflow:change-me@localhost:5432/bakeflow

# --- LLM gateway (BAKE-9) ---
# Sprint 1 runs on MockLLMClient; leave these empty until a provider is chosen.
BAKEFLOW_LLM_BASE_URL=
BAKEFLOW_LLM_API_KEY=
BAKEFLOW_LLM_MODEL=
